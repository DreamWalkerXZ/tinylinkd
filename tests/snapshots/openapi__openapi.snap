        ],
        "type": "object"
      },
      "CreatedInviteResponse": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "token": {
            "description": "The plaintext Invite token. Returned only in this response.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "token",
          "expires_at",
          "created_at"
        ],
        "type": "object"
      },
