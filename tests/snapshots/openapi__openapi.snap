---
source: tests/openapi.rs
expression: "serde_json::to_string_pretty(&document).expect(\"pretty JSON\")"
---
{
  "components": {
    "schemas": {
      "AcceptInviteRequest": {
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "AcceptPasswordResetRequest": {
        "properties": {
          "password": {
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "type": "object"
      },
      "ClickListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ClickResponse"
            },
            "type": "array"
          },
