          "offset"
        ],
        "type": "object"
      },
      "InviteResponse": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "created_by": {
            "format": "int64",
            "type": "integer"
          },
          "expires_at": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "One of `pending`, `used`, `expired`, or `revoked`.",
            "type": "string"
          },
          "used_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "created_by",
          "status",
          "expires_at",
          "created_at"
