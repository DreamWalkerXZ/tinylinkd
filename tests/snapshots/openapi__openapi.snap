---
source: tests/openapi.rs
expression: "serde_json::to_string_pretty(&document).expect(\"pretty JSON\")"
---
{
  "components": {
    "schemas": {
      "AcceptInviteRequest": {
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "AcceptPasswordResetRequest": {
        "properties": {
          "password": {
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "CreateLinkRequest": {
        "properties": {
          "destination_url": {
            "description": "The absolute `http` or `https` URL the Link redirects to.",
            "type": "string"
          },
          "slug": {
            "description": "An optional custom Slug. An 8-character random Slug is generated when omitted.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "destination_url"
        ],
        "type": "object"
      },
      "CreateTokenRequest": {
        "properties": {
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreatedInviteResponse": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "token": {
            "description": "The plaintext Invite token. Returned only in this response.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "token",
          "expires_at",
          "created_at"
        ],
        "type": "object"
      },
      "CreatedPasswordResetResponse": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "token": {
            "description": "The plaintext password-reset token. Returned only in this response.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "token",
          "expires_at",
          "created_at"
        ],
        "type": "object"
      },
      "CreatedTokenResponse": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "token": {
            "description": "The plaintext API token. Returned only in this response.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "prefix",
          "token",
          "created_at"
        ],
        "type": "object"
      },
      "InviteListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/InviteResponse"
            },
            "type": "array"
          },
          "limit": {
            "format": "int64",
            "type": "integer"
          },
          "offset": {
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "type": "object"
      },
      "InviteResponse": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "created_by": {
            "format": "int64",
            "type": "integer"
          },
          "expires_at": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "One of `pending`, `used`, `expired`, or `revoked`.",
            "type": "string"
          },
          "used_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "created_by",
          "status",
          "expires_at",
          "created_at"
        ],
        "type": "object"
      },
      "InviteValidationResponse": {
        "properties": {
          "expires_at": {
            "type": "string"
          },
          "status": {
            "description": "One of `valid`, `expired`, `used`, or `revoked`.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "expires_at"
        ],
        "type": "object"
      },
      "LinkListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LinkResponse"
            },
            "type": "array"
          },
          "limit": {
            "format": "int64",
            "type": "integer"
          },
          "offset": {
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "type": "object"
      },
      "LinkResponse": {
        "properties": {
          "bot_clicks": {
            "format": "int64",
            "type": "integer"
          },
          "created_at": {
            "type": "string"
          },
          "destination_url": {
            "type": "string"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_password": {
            "description": "Whether the Link requires a password before it redirects.",
            "type": "boolean"
          },
          "human_clicks": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "owner_id": {
            "format": "int64",
            "type": "integer"
          },
          "short_url": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/LinkStatus"
          },
          "total_clicks": {
            "format": "int64",
            "type": "integer"
          },
          "updated_at": {
            "type": "string"
          },
          "warning": {
            "description": "Present only when an update changed the Slug: the old short URL stops\nworking immediately and may be reused by another Link.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "owner_id",
          "slug",
          "short_url",
          "destination_url",
          "has_password",
          "status",
          "created_at",
          "updated_at",
          "total_clicks",
          "human_clicks",
          "bot_clicks"
        ],
        "type": "object"
      },
      "LinkStatus": {
        "enum": [
          "active",
          "expired"
        ],
        "type": "string"
      },
      "Pagination": {
        "properties": {
          "limit": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "PasswordResetValidationResponse": {
        "properties": {
          "expires_at": {
            "type": "string"
          },
          "status": {
            "description": "One of `valid`, `expired`, `used`, or `revoked`.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "expires_at"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "description": "An RFC 9457 Problem Details response with a machine-readable `code`.",
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "type": "object"
      },
      "TokenListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TokenResponse"
            },
            "type": "array"
          },
          "limit": {
            "format": "int64",
            "type": "integer"
          },
          "offset": {
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "prefix",
          "created_at"
        ],
        "type": "object"
      },
      "UpdateLinkRequest": {
        "properties": {
          "destination_url": {
            "description": "The new absolute `http` or `https` URL the Link redirects to.",
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "description": "A non-empty string sets or changes the Link's password; `null` clears\nit and makes the Link redirect without a password. Omit the field to\nleave the password unchanged.",
            "type": [
              "string",
              "null"
            ]
          },
          "slug": {
            "description": "A new Slug. A Slug change returns a `warning` because the old short URL\nstops working immediately and may be reused by another Link.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UserProfile": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "role": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The JSON API for a self-hosted tinylinkd Instance. Authenticate with a Bearer API token.",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "tinylinkd API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/_/api/v1/invites": {
      "get": {
        "operationId": "list_invites",
        "parameters": [
          {
            "description": "Maximum number of Invites to return (default 20, maximum 100).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Number of Invites to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteListResponse"
                }
              }
            },
            "description": "All Invites with their status. Plaintext tokens and hashes are never listed."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing, invalid, revoked, or expired API token."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The current User is not an Admin."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid pagination parameters."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "invites"
        ]
      },
      "post": {
        "operationId": "create_invite",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedInviteResponse"
                }
              }
            },
            "description": "Invite created. The plaintext `token` is returned only in this response."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing, invalid, revoked, or expired API token."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The current User is not an Admin."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "invites"
        ]
      }
    },
    "/_/api/v1/invites/{id}": {
      "delete": {
        "operationId": "revoke_invite",
        "parameters": [
          {
            "description": "The Invite id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The Invite was revoked. Revoking an already revoked Invite is a no-op."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing, invalid, revoked, or expired API token."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The current User is not an Admin."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "No such Invite."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The Invite has already been used."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "invites"
        ]
      }
    },
    "/_/api/v1/invites/{token}": {
      "get": {
        "operationId": "validate_invite",
        "parameters": [
          {
            "description": "The plaintext Invite token.",
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteValidationResponse"
                }
              }
            },
            "description": "The Invite is valid, expired, used, or revoked."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "No such Invite."
          }
        },
        "tags": [
          "invites"
        ]
      }
    },
    "/_/api/v1/invites/{token}/accept": {
      "post": {
        "operationId": "accept_invite",
        "parameters": [
          {
            "description": "The plaintext Invite token.",
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInviteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            },
            "description": "The Invite was accepted and the User was created."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "No such Invite."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The Invite was already used or revoked, or the username or email is taken."
          },
          "410": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The Invite has expired."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The username, email, or password is invalid."
          }
        },
        "tags": [
          "invites"
        ]
      }
    },
    "/_/api/v1/links": {
      "get": {
        "operationId": "list_links",
        "parameters": [
          {
            "description": "Maximum number of Links to return (default 20, maximum 100).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Number of Links to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Filter by status: `active` or `expired`.",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Search the Slug and Destination URL.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Sort order: `created_at` (oldest first) or `-created_at` (newest first, the default).",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Admin-only: list only the Links owned by this User.",
            "in": "query",
            "name": "owner_id",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkListResponse"
                }
              }
            },
            "description": "The current User's Links, or all Links for an Admin."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing, invalid, revoked, or expired API token."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "A non-Admin used the Admin-only `owner_id` filter."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid pagination, status, or sort parameters."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "links"
        ]
      },
      "post": {
        "operationId": "create_link",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLinkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkResponse"
                }
              }
            },
            "description": "Link created."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing, invalid, revoked, or expired API token."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The custom Slug is already taken."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The Destination URL or Slug is invalid."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "links"
        ]
      }
    },
    "/_/api/v1/links/{id}": {
      "delete": {
        "operationId": "delete_link",
        "parameters": [
          {
