        "properties": {
          "expires_at": {
            "type": "string"
          },
          "status": {
            "description": "One of `valid`, `expired`, `used`, or `revoked`.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "expires_at"
        ],
        "type": "object"
      },
      "LinkListResponse": {
        "properties": {
