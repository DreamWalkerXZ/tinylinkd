          "total",
          "limit",
          "offset"
        ],
        "type": "object"
      },
      "LinkResponse": {
        "properties": {
          "bot_clicks": {
            "format": "int64",
            "type": "integer"
          },
          "created_at": {
            "type": "string"
          },
          "destination_url": {
            "type": "string"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_password": {
            "description": "Whether the Link requires a password before it redirects.",
            "type": "boolean"
          },
          "human_clicks": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "owner_id": {
            "format": "int64",
            "type": "integer"
          },
          "short_url": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/LinkStatus"
          },
          "total_clicks": {
            "format": "int64",
            "type": "integer"
          },
          "updated_at": {
            "type": "string"
          },
          "warning": {
            "description": "Present only when an update changed the Slug: the old short URL stops\nworking immediately and may be reused by another Link.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "owner_id",
          "slug",
          "short_url",
          "destination_url",
          "has_password",
          "status",
          "created_at",
          "updated_at",
          "total_clicks",
          "human_clicks",
          "bot_clicks"
        ],
        "type": "object"
      },
      "LinkStatsResponse": {
        "properties": {
          "bot_clicks": {
            "description": "Clicks whose User-Agent matched a crawler pattern.",
            "format": "int64",
            "type": "integer"
          },
          "by_day": {
            "description": "Clicks by calendar day in the Instance timezone, oldest first. Only\ndays with Clicks appear.",
            "items": {
              "$ref": "#/components/schemas/DayCount"
            },
            "type": "array"
          },
          "by_device": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "description": "Clicks by device, including bot-device Clicks.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "human_clicks": {
            "description": "Clicks whose User-Agent did not match a crawler pattern.",
            "format": "int64",
            "type": "integer"
          },
          "total_clicks": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "total_clicks",
          "human_clicks",
          "bot_clicks",
          "by_device",
          "by_day"
        ],
        "type": "object"
      },
      "LinkStatus": {
        "enum": [
          "active",
          "expired"
        ],
        "type": "string"
      },
      "Pagination": {
        "properties": {
          "limit": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "PasswordResetValidationResponse": {
        "properties": {
          "expires_at": {
            "type": "string"
          },
          "status": {
            "description": "One of `valid`, `expired`, `used`, or `revoked`.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "expires_at"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "description": "An RFC 9457 Problem Details response with a machine-readable `code`.",
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "type": "object"
      },
      "SettingsResponse": {
        "description": "The mutable Instance settings. The HMAC signing key and the `secrets`\ntable are never part of this response.",
        "properties": {
          "click_retention_days": {
            "format": "int64",
            "type": "integer"
          },
          "instance_name": {
            "type": "string"
          },
          "password_unlock_ttl_seconds": {
            "format": "int64",
            "type": "integer"
          },
          "timezone": {
            "description": "The IANA timezone used for daily Click buckets and display.",
            "type": "string"
          }
        },
        "required": [
          "instance_name",
          "timezone",
          "click_retention_days",
          "password_unlock_ttl_seconds"
        ],
        "type": "object"
      },
      "TokenListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TokenResponse"
            },
            "type": "array"
          },
          "limit": {
            "format": "int64",
            "type": "integer"
          },
          "offset": {
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "prefix",
          "created_at"
        ],
        "type": "object"
      },
      "UpdateLinkRequest": {
        "properties": {
          "destination_url": {
            "description": "The new absolute `http` or `https` URL the Link redirects to.",
            "type": [
              "string",
              "null"
            ]
          },
          "owner_id": {
            "description": "Admin-only: transfer the Link to another existing User.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "password": {
            "description": "A non-empty string sets or changes the Link's password; `null` clears\nit and makes the Link redirect without a password. Omit the field to\nleave the password unchanged.",
            "type": [
              "string",
              "null"
            ]
          },
          "slug": {
            "description": "A new Slug. A Slug change returns a `warning` because the old short URL\nstops working immediately and may be reused by another Link.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpdateProfileRequest": {
        "properties": {
          "email": {
            "description": "The new optional email. Omit it to keep the current email; send `null`\nor an empty string to clear it.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpdateSettingsRequest": {
        "properties": {
          "click_retention_days": {
            "description": "The Click retention window in days. Must be positive.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "instance_name": {
            "description": "A non-empty Instance name.",
            "type": [
              "string",
              "null"
            ]
          },
          "password_unlock_ttl_seconds": {
            "description": "The password-unlock cookie lifetime in seconds. Must be positive.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "timezone": {
            "description": "An IANA timezone name, for example `Europe/London`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpdateUserRequest": {
        "properties": {
          "disabled": {
            "description": "When true, disable the User and revoke all of their API tokens. When\nfalse, re-enable the User; revoked tokens are never restored.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "email": {
            "description": "The new optional email. Omit it to keep the current email; send `null`\nor an empty string to clear it.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UserListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/UserProfile"
            },
            "type": "array"
          },
          "limit": {
            "format": "int64",
            "type": "integer"
          },
          "offset": {
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "type": "object"
      },
      "UserProfile": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "role": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "disabled",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The JSON API for a self-hosted tinylinkd Instance. Authenticate with a Bearer API token.",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "tinylinkd API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/_/api/v1/invites": {
      "get": {
        "operationId": "list_invites",
        "parameters": [
          {
            "description": "Maximum number of Invites to return (default 20, maximum 100).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Number of Invites to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteListResponse"
                }
              }
            },
            "description": "All Invites with their status. Plaintext tokens and hashes are never listed."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing, invalid, revoked, or expired API token."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The current User is not an Admin."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid pagination parameters."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "invites"
        ]
      },
      "post": {
        "operationId": "create_invite",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedInviteResponse"
                }
              }
            },
            "description": "Invite created. The plaintext `token` is returned only in this response."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing, invalid, revoked, or expired API token."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The current User is not an Admin."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "invites"
        ]
      }
    },
    "/_/api/v1/invites/{id}": {
      "delete": {
        "operationId": "revoke_invite",
        "parameters": [
          {
            "description": "The Invite id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The Invite was revoked. Revoking an already revoked Invite is a no-op."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing, invalid, revoked, or expired API token."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The current User is not an Admin."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "No such Invite."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
