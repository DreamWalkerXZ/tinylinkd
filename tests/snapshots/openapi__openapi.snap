            "type": "integer"
          },
          "offset": {
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "type": "object"
      },
      "ClickResponse": {
        "properties": {
          "clicked_at": {
            "type": "string"
          },
          "device": {
            "description": "One of `desktop`, `mobile`, `tablet`, `bot`, or `unknown`.",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "ip": {
            "type": "string"
          },
          "is_bot": {
            "description": "Whether the User-Agent matched a known crawler pattern. Bot Clicks are\nstored and listed but excluded from human counts.",
            "type": "boolean"
          },
          "referer": {
            "type": [
              "string",
              "null"
            ]
          },
          "user_agent": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "clicked_at",
          "ip",
          "user_agent",
          "device",
          "is_bot"
        ],
        "type": "object"
      },
      "CreateLinkRequest": {
        "properties": {
          "destination_url": {
            "description": "The absolute `http` or `https` URL the Link redirects to.",
            "type": "string"
          },
          "slug": {
            "description": "An optional custom Slug. An 8-character random Slug is generated when omitted.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "destination_url"
        ],
        "type": "object"
      },
