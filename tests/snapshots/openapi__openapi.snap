---
source: tests/openapi.rs
expression: "serde_json::to_string_pretty(&document).expect(\"pretty JSON\")"
---
{
  "components": {
    "schemas": {
      "CreateTokenRequest": {
        "properties": {
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreatedTokenResponse": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "token": {
            "description": "The plaintext API token. Returned only in this response.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "prefix",
          "token",
          "created_at"
        ],
        "type": "object"
      },
      "Pagination": {
        "properties": {
          "limit": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ProblemDetails": {
        "description": "An RFC 9457 Problem Details response with a machine-readable `code`.",
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "type": "object"
      },
      "TokenListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TokenResponse"
            },
            "type": "array"
          },
          "limit": {
            "format": "int64",
            "type": "integer"
          },
          "offset": {
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "prefix",
          "created_at"
        ],
        "type": "object"
      },
      "UserProfile": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "role": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The JSON API for a self-hosted tinylinkd Instance. Authenticate with a Bearer API token.",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "tinylinkd API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/_/api/v1/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            },
            "description": "The current User profile."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing, invalid, revoked, or expired API token."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/_/api/v1/tokens": {
      "get": {
        "operationId": "list_tokens",
        "parameters": [
          {
            "description": "Maximum number of API tokens to return (default 20, maximum 100).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Number of API tokens to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenListResponse"
                }
              }
            },
            "description": "The current User's API tokens. Plaintext tokens are never listed."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing, invalid, revoked, or expired API token."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid pagination parameters."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "tokens"
        ]
      },
      "post": {
        "operationId": "create_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedTokenResponse"
                }
              }
            },
            "description": "API token created. The plaintext `token` is returned only in this response."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing, invalid, revoked, or expired API token."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The token name or expiry is invalid."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "tokens"
        ]
      }
    },
    "/_/api/v1/tokens/{id}": {
      "delete": {
        "operationId": "revoke_token",
        "parameters": [
          {
            "description": "The API token id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The API token was revoked."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing, invalid, revoked, or expired API token."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "No such API token belongs to the current User."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "tokens"
        ]
      }
    }
  }
}
