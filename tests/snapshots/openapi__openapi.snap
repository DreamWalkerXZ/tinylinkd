    "/_/api/v1/password-resets/{token}/accept": {
      "post": {
        "operationId": "accept_password_reset",
        "parameters": [
          {
            "description": "The plaintext password-reset token.",
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
